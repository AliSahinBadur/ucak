# Copy this file to .env and adjust as needed. All values shown are defaults;
# uncomment and edit only what you need to override. See app/config.py (Settings).

# --- Application variant / branding (see app/branding.py) ---
# APP_VARIANT=big_agent  # one of: big_agent, raporhub, repocto

# --- Storage ---
# BIG_AGENT_DATA_DIR=./data

# --- Auth (off by default; LAN-demo grade only, see README) ---
# APP_AUTH_ENABLED=false
# APP_USERS=user1:pass1;user2:pass2
# APP_SESSION_SECRET=
# APP_AUTH_COOKIE_NAME=big_agent_session

# --- Embeddings ---
# EMBEDDING_MODEL_PATH=
# EMBEDDING_BACKEND=token-hash
# EMBEDDING_DEVICE=auto
# EMBEDDING_LOCAL_FILES_ONLY=false
# EMBEDDING_SHOW_PROGRESS=false

# --- Base LLM (used as a fallback by CHAT_LLM_* / REPORT_LLM_* below) ---
# LLM_ENABLED=false
# LLM_BACKEND=disabled
# LLM_MODEL_NAME=
# LLM_MODEL_PATH=
# LLM_MAX_CONTEXT_TOKENS=4096
# LLM_TIMEOUT_SECONDS=30
# LLM_ANSWER_ENABLED=false
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Chat LLM ---
# CHAT_LLM_ENABLED=true
# CHAT_LLM_BACKEND=ollama
# CHAT_LLM_MODEL_NAME=qwen2.5:3b
# CHAT_LLM_TIMEOUT_SECONDS=45

# --- Report-writing LLM (falls back to CHAT_LLM_* if unset) ---
# REPORT_LLM_ENABLED=true
# REPORT_LLM_BACKEND=
# REPORT_LLM_MODEL_NAME=
# REPORT_LLM_TIMEOUT_SECONDS=

# --- Reranker ---
# RERANKER_ENABLED=false
# RERANKER_BACKEND=disabled
# RERANKER_MODEL_PATH=

# --- Catalog folder ingest ---
# Semicolon-separated list of network/local roots to scan.
# CATALOG_SEARCH_ROOTS=\\isufile02\argevalidasyon$\RAPORLAR;V:/RAPORLAR;V:/

# --- Selective OCR (used only for PDF pages with too little selectable text;
# --- needs a local Tesseract install with language data, plus pymupdf) ---
# OCR_ENABLED=true
# OCR_LANGUAGES=tur+eng
# OCR_DPI=250
# OCR_MIN_TEXT_CHARACTERS=100
# OCR_TESSDATA_DIR=
# OCR_TESSERACT_CMD=

# --- RepOcto library browser ---
# Semicolon-separated extra roots allowed for /library/scan (repocto variant only).
# Defaults always include the app documents dir, V:/RAPORLAR and
# "V:/CAE/Dijital Dönüşüm Çalışmaları".
# REPOCTO_LIBRARY_ROOTS=

# --- CATIA mass/CG skill (skill/catia-mass-cg.skill) ---
# Off by default; enable only on the workstation where CATIA runs. The
# endpoints are localhost-only. Source "fake" uses the synthetic assembly
# (practice mode, no CATIA needed); set "catia" deliberately for real
# measurements. Requires an Ollama model with reliable tool calling
# (qwen3:4b-instruct, Q5_K_M or better — see runner/README.md in the skill).
# When enabled, the V2 workspace shows a "CATIA kütle / CG" module in the tool
# rail; it stays hidden for everyone else and explains itself to LAN clients.
# CATIA_SKILL_ENABLED=false
# CATIA_SKILL_SOURCE=fake
# CATIA_SKILL_MODEL_NAME=qwen3:4b-instruct
# CATIA_SKILL_WORKSPACE_ROOT=
# CATIA_SKILL_LLM_TIMEOUT_SECONDS=600
# CATIA_SKILL_CMC_TIMEOUT_SECONDS=900
# CATIA_SKILL_MAX_STEPS=12
# CATIA_SKILL_MAX_NUDGES=3
